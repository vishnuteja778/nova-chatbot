# Copy this file to ".env" and put your real keys after the = signs.

# --- Groq (used by hello.py and list_models.py) ---
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=paste-your-groq-key-here
# Run "python list_models.py" to see which models your key can use.
GROQ_MODEL=openai/gpt-oss-20b

# --- Gemini (used by the scripts in the gemini/ folder) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=paste-your-key-here
GEMINI_MODEL=gemini-3.8-flash
